# Python
__pycache__/
*.py[cod]
tmp/venv/
tmp/venv-data/
venv/
.pytest_cache/

# Node (не е нужен за приложението, но може да се ползва за инструменти)
node_modules/

# Браузъри на Playwright и снимки от проверките
tmp/pw-browsers/
render-check/

# Суровите данни не се качват (docs/data-sources.md)…
data/originals/*
data/raw/
# …освен файловете на МФ (minfin.bg): 33-те месечни отчета по КФП, PDF-а с АСБП и материалите за бюджет 2027, около 13 MB. С тях всеки може да сглоби данните
# от чисто копие. Останалите източници се свалят автоматично (pipeline/budget_pipeline/sources/originals.py) и остават извън Git.
!data/originals/budget_2027/
!data/originals/kfp_2022/
!data/originals/kfp_2023/
!data/originals/kfp-history-acquisition.json
!data/originals/kfp_2024/
!data/originals/kfp_2025/
!data/originals/kfp_2026/
!data/originals/asbp/
data/originals/asbp/*
!data/originals/asbp/UMTBF-2026-2028-motivi.pdf

# Временни файлове и кешове
tmp/
data/cache/
.tmp/
*.log
.DS_Store
Thumbs.db

# Тайни
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example
!.dev.vars.example
.secrets

# Собствените среди: адресите и id-тата на твоя Cloudflare акаунт (docs/release.md, „Среди“)
wrangler.local.jsonc
pipeline/environments.local.json

# Генерираният изход се игнорира само там, където инструментите го пишат. Голо име на папка (build/, dist/, coverage/) би скрило
# и изходни папки със същото име, например packages/ingest/src/build/: нов файл там не би стигнал до Git. Пазачът е
# apps/web/workers/repository-ignore.test.ts.
# Сглобеното SSR приложение (react-router build и pnpm build:release, apps/web/react-router.config.ts)
/apps/web/build/
# Компилираните TypeScript пакети (tsc -p tsconfig.build.json, outDir dist)
/apps/*/dist/
/packages/*/dist/
# Покритието от pnpm test -- --coverage (vitest.shared.ts, reportsDirectory ./coverage)
/apps/*/coverage/
/packages/*/coverage/
# Изходът от по-старата подредба в корена: статичният сайт (apps/web/scripts/ssr_parity.py --dist dist) и SSR build
/dist/
/build/
# Генерираните типове на React Router и локалното състояние на wrangler (имена на инструменти, не на изходни папки)
.react-router/
.wrangler/
# Локалните бележки и разписките на операторските команди (apps/etl/src/release-operator.ts: work/ts-operator-receipts)
/work/

*.egg-info/

# Turbo task cache (в корена и във всеки workspace)
.turbo/

!data/originals/state_budget/
!data/originals/fiscal_quarterly/
!data/originals/taxes-subsectors-acquisition.json

!data/originals/debt/
!data/originals/debt-issues-acquisition.json
