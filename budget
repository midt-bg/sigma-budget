#!/bin/sh
# Python 3.12+, using the pinned pipeline environment when available.
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export PYTHONPATH="$root/pipeline${PYTHONPATH:+:$PYTHONPATH}"
for py in "$root/tmp/venv-data/bin/python" "$root/tmp/venv/bin/python" python3; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys, yaml; assert sys.version_info >= (3, 12)" 2>/dev/null; then
    exec "$py" -m budget_pipeline.cli "$@"
  fi
done
echo "budget: needs Python 3.12+ with the hash-locked dependencies" >&2
exit 2
