#!/bin/sh
# The budget command (docs/approach-specification.md, section 8.1; docs/release.md): pipeline/budget_pipeline/cli.py with any Python 3.9+ and PyYAML.
# Builds run in the pinned image of pipeline/Dockerfile when docker answers, else in tmp/venv-data.
for py in "$(dirname "$0")/tmp/venv-data/bin/python" "$(dirname "$0")/tmp/venv/bin/python" python3; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c "import yaml" 2>/dev/null; then exec "$py" "$(dirname "$0")/pipeline/budget_pipeline/cli.py" "$@"; fi
done
echo "budget: needs Python 3.9+ with PyYAML (pip install --require-hashes -r tests/requirements-dev.lock)" >&2
exit 2
